{
  "$schema": "http://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    /* Module Resolution */
    "moduleResolution": "node",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* Emit */
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    /* Interop Constraints */
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "electron-api/**/*.ts",
    "os-system/**/*.ts",
    "monitor/**/*.ts",
    "tsf/**/*.ts",
    "capture/**/*.ts",
    "block-manager/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}