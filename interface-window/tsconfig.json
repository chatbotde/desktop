{
  "$schema": "http://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    /* Module Resolution */
    "moduleResolution": "node",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    /* Type Checking */
    "strict": true,
    "noUnusedLocals": false, // Disabled for faster builds - can enable in CI
    "noUnusedParameters": false, // Disabled for faster builds - can enable in CI
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "skipLibCheck": true, // Skip type checking of declaration files - significant speedup
    "forceConsistentCasingInFileNames": true,
    /* Emit */
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false, // Disable declaration maps for faster builds
    "sourceMap": true,
    "removeComments": true, // Remove comments for faster builds
    "importHelpers": true,
    "incremental": true, // Enable incremental compilation
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    /* Interop Constraints */
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "electron-api/**/*.ts",
    "os-system/**/*.ts",
    "monitor/**/*.ts",
    "tsf/**/*.ts",
    "capture/**/*.ts",
    "block-manager/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}