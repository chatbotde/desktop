# Production Environment Variables for GitHub Actions
# These are set to empty strings because the application should work
# without hardcoded API keys - users can input their own API keys

# AI API Keys (empty for production builds - users input their own)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
REPLICATE_API_TOKEN=

# Database (empty for production builds)
DATABASE_URL=

# Authentication (empty for production builds)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Note: The application is designed to work without these environment variables
# Users can input their own API keys through the UI
