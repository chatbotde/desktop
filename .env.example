# Optional. Buddy runs without these — add keys in Settings, or fill values here.
# Never commit a real .env file.

# Hosted SonicThinking login is OFF by default (forks / local builds).
# Do not set these unless you run your own auth server:
# AUTH_SERVER_URL=https://your-auth-server.example
# REQUIRE_AUTH=true
# SKIP_AUTH=true

GEMINI_API_KEY=#gemini api key here
OPENAI_API_KEY=#openai api key here
DATABASE_URL=#supabase connection key
BETTER_AUTH_SECRET=#better auth secret
BETTER_AUTH_URL=#better auth url
SARVAM_API_KEY=#sarvam ai subscription key from https://dashboard.sarvam.ai/
COMPOSIO_API_KEY=#composio api key from https://app.composio.dev/settings

# LiveKit — live screen streaming for Remote Pad (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloud pairing — connect from any network (run buddy/remote-pad/sql/cloud-pairing.sql in Supabase)
# LiveKit starts only when your phone connects — Supabase registration alone is free.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=