{
  "name": "buddy",
  "productName": "Buddy",
  "version": "1.0.0",
  "main": "main.js",
  "homepage": "https://github.com/sonicthinking/buddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonicthinking/buddy.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:all": "npm run build && node build-frontend.js",
    "build:electron": "npm run build && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test-chat": "electron test-chat-input.js",
    "test-capture": "electron chat-input/test-capture-runner.js",
    "test-text-selection": "electron test-text-selection.js",
    "debug-text-selection": "node debug-text-selection.js",
    "test-selection-hook": "electron test-selection-hook.js",
    "test-simple-selection": "node simple-selection-test.js",
    "debug-text-selection-monitor": "node debug-text-selection-monitor.js",
    "package": "npm run build:all && electron-forge package",
    "make": "npm run build:all && electron-forge make"
  },
  "keywords": [
    "desktop",
    "companion",
    "productivity",
    "electron"
  ],
  "author": "sonicthinking",
  "license": "ISC",
  "description": "A desktop companion app built with Electron",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.7.1",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "selection-hook": "^1.0.12",
    "tesseract.js": "^5.1.1"
  }
}
